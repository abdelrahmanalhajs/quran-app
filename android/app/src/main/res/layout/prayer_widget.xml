<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/prayer_widget_bg"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/widget_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="—" />

        <TextView
            android:id="@+id/widget_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#D6F0E4"
            android:textSize="14sp"
            android:layout_marginStart="6dp"
            android:text="" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/widget_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFD27A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="2dp" />

    <!-- Hidden label/placeholder holder reused for the no-data message. -->
    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#B8E0CE"
        android:textSize="11sp"
        android:visibility="gone" />

</LinearLayout>
